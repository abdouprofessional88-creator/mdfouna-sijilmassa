# ── Server ─────────────────────────────────────
PORT=4000
# Comma-separated list of allowed frontend origins (CORS + cookies)
CLIENT_ORIGINS=http://localhost:5173

# ── MySQL ──────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sijilmassa
DB_PASSWORD=change-me-strong-password
DB_NAME=sijilmassa_db
# Root credentials are ONLY used by the one-time setup script (db:create).
# Remove them afterwards.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# ── Auth ───────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRES_IN=7d
# Cookie name for the session token
AUTH_COOKIE=sijilmassa_token

# ── Demo data ──────────────────────────────────
# Set to 0 to skip demo accounts during seeding (recommended for staging).
SEED_DEMO=1

# ── Rate limiting (per-IP sliding window, in-memory) ──
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_AUTH_MAX=60
RATE_LIMIT_WRITE_MAX=300

# ── Payments ───────────────────────────────────
# Provider: mock_dev (local simulator, honest dev-only flow) | stripe | cmi.
# Stripe does NOT onboard Moroccan businesses directly; CMI (Centre Monétique
# Interbancaire) is the correct production gateway for Morocco and requires a
# merchant contract — fill the keys below only when the contract exists.
PAYMENT_PROVIDER=mock_dev
PAYMENT_CURRENCY=MAD
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
# STRIPE_SECRET_KEY= (only if PAYMENT_PROVIDER=stripe)
# STRIPE_WEBHOOK_SECRET= (only if PAYMENT_PROVIDER=stripe)
# CMI_STORE_ID= / CMI_STORE_KEY= / CMI_* (only if PAYMENT_PROVIDER=cmi, per CMI docs)
